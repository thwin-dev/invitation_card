APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CLIENT_PASSWORD_RESET_URL=http://localhost:3000/reset-password
SANCTUM_EXPIRATION=480

APP_LOCALE=en
APP_TIMEZONE="Asia/Yangon"
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4
ALLOWED_ORIGINS="*"

BCRYPT_ROUNDS=12

SANCTUM_EXPIRATION=480

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

BACKUP_ENABLED=true
BACKUP_DISK=local
BACKUP_DIRECTORY=backups
BACKUP_SCHEDULE_TIME=02:00
BACKUP_RETENTION_TIME=03:00
BACKUP_RETENTION_DAYS=30
# Keep this key stable to restore older backups. Defaults to APP_KEY when empty.
BACKUP_ENCRYPTION_KEY=
BACKUP_MAX_RESTORE_UPLOAD_KB=512000
BACKUP_MAX_RESTORE_UNCOMPRESSED_KB=1048576
BACKUP_MAX_RESTORE_FILES=25000
MYSQLDUMP_BINARY=mysqldump
MYSQL_CLIENT_BINARY=mysql

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=postmark
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
POSTMARK_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

